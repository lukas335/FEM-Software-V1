    <SurfacePair name="shell_contact">
      <primary>measurement_contact</primary>
      <secondary>pressure_contact</secondary>
    </SurfacePair>
    <SurfacePair name="measurement_interface_I001">
      <primary>measurement_interface_I001_a</primary>
      <secondary>measurement_interface_I001_b</secondary>
    </SurfacePair>
  </Mesh>
  <MeshDomains>
    <SolidDomain name="measurement_R001" mat="shell_1" />
    <SolidDomain name="measurement_R002" mat="shell_2" />
    <SolidDomain name="pressure_shell" mat="shell_3" />
  </MeshDomains>
  <Boundary>
    <bc type="zero displacement" node_set="pressure_support">
      <x_dof>1</x_dof>
      <y_dof>1</y_dof>
      <z_dof>1</z_dof>
    </bc>
    <bc type="zero displacement" node_set="axis_transverse_fixed">
      <y_dof>1</y_dof>
      <z_dof>1</z_dof>
    </bc>
  </Boundary>
  <Constraints>
    <constraint type="symmetry plane" surface="measurement_symmetry_0">
      <laugon>0</laugon>
      <penalty>10.0</penalty>
    </constraint>
    <constraint type="symmetry plane" surface="measurement_symmetry_1">
      <laugon>0</laugon>
      <penalty>10.0</penalty>
    </constraint>
    <constraint type="symmetry plane" surface="pressure_symmetry_0">
      <laugon>0</laugon>
      <penalty>10.0</penalty>
    </constraint>
    <constraint type="symmetry plane" surface="pressure_symmetry_1">
      <laugon>0</laugon>
      <penalty>10.0</penalty>
    </constraint>
  </Constraints>
  <Contact>
    <contact type="sliding-elastic" surface_pair="shell_contact">
      <auto_penalty>1</auto_penalty>
      <two_pass>1</two_pass>
      <laugon>1</laugon>
      <fric_coeff>0</fric_coeff>
    </contact>
    <contact type="sliding-elastic" surface_pair="measurement_interface_I001">
      <auto_penalty>1</auto_penalty>
      <two_pass>1</two_pass>
      <laugon>1</laugon>
      <fric_coeff>0</fric_coeff>
    </contact>
  </Contact>
  <LoadData>
    <load_controller id="1" type="loadcurve">
      <points>
        <point>0,0</point>
        <point>1,1</point>
        <point>2,1</point>
      </points>
    </load_controller>
    <load_controller id="2" type="loadcurve">
      <points>
        <point>0,0</point>
        <point>1,0</point>
        <point>2,1</point>
      </points>
    </load_controller>
  </LoadData>
  <Loads>
    <surface_load type="pressure" surface="pressure_inner_surface">
      <pressure lc="1">1.33322e-05</pressure>
      <symmetric_stiffness>0</symmetric_stiffness>
    </surface_load>
  </Loads>
  <Step>
    <step id="1" name="pressure">
      <Control>
        <analysis>STATIC</analysis>
        <time_steps>2</time_steps>
        <step_size>.5</step_size>
        <solver type="solid">
          <max_refs>25</max_refs>
          <symmetric_stiffness>0</symmetric_stiffness>
          <ls_check_jacobians>1</ls_check_jacobians>
        </solver>
        <time_stepper>
          <dtmin>0.0001</dtmin>
          <dtmax>.5</dtmax>
          <max_retries>8</max_retries>
        </time_stepper>
      </Control>
      <Boundary>
        <bc type="prescribed displacement" node_set="measurement_support">
          <dof>x</dof>
          <value>0</value>
        </bc>
      </Boundary>
    </step>
    <step id="2" name="indentation">
      <Control>
        <analysis>STATIC</analysis>
        <time_steps>2</time_steps>
        <step_size>.5</step_size>
        <solver type="solid">
          <max_refs>25</max_refs>
          <symmetric_stiffness>0</symmetric_stiffness>
          <ls_check_jacobians>1</ls_check_jacobians>
        </solver>
        <time_stepper>
          <dtmin>0.0001</dtmin>
          <dtmax>.5</dtmax>
          <max_retries>8</max_retries>
        </time_stepper>
      </Control>
      <Boundary>
        <bc type="prescribed displacement" node_set="measurement_support">
          <dof>x</dof>
          <value lc="2">0.05</value>
        </bc>
      </Boundary>
    </step>
  </Step>
  <Output>
    <logfile file="solver.log">
      <node_data data="ux;Rx" name="support_reaction">6,7,8,9,25,26,27,96,97,98,99,100,101,102,103,104,105,106,107,239,240,241,242,243,244,673,674,675,676,677,678,679</node_data>
      <node_data data="ux" name="measurement_inner_pole">1562</node_data>
      <face_data data="contact gap;contact pressure" name="contact_state" surface="measurement_contact" />
    </logfile>
  </Output>
</febio_spec>